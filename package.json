{
	"name": "lapkart",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"android:web": "node scripts/build-capacitor.mjs web",
		"android:sync": "node scripts/build-capacitor.mjs sync",
		"android:build": "node scripts/build-capacitor.mjs apk",
		"android:bundle": "node scripts/build-capacitor.mjs bundle",
		"android:release": "node scripts/build-capacitor.mjs release",
		"android:release:apk": "node scripts/build-capacitor.mjs release-apk",
		"android:install": "node scripts/build-capacitor.mjs install",
		"android:open": "cap open android",
		"typesense:sync": "node scripts/sync-typesense-products.mjs --full --queue",
		"typesense:reindex": "node scripts/sync-typesense-products.mjs --full --recreate --queue"
	},
	"dependencies": {
		"@capacitor/android": "^8.4.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/camera": "^8.2.0",
		"@capacitor/core": "^8.4.0",
		"@capacitor/device": "^8.0.2",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/share": "^8.0.1",
		"@capacitor/splash-screen": "^8.0.1",
		"@lucide/svelte": "^1.17.0",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.107.0",
		"tw-animate-css": "^1.3.4"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.4.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/mcp": "^0.1.24",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.56.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	}
}
